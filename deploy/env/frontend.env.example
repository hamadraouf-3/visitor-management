# nginx (frontend service) of docker-compose.yml.
#
#   cp deploy/env/frontend.env.example deploy/env/frontend.env
#
# The public host name(s) of the application, separated by spaces. Requests for any other name are
# not answered (and TLS handshakes without a matching SNI are refused), so clients must use one of
# these names, never the IP address. The TLS certificate in deploy/tls/tls.crt must cover them, and
# APP_BASE_URL / ALLOWED_ORIGINS in backend.env must use them.
VMS_SERVER_NAME=vms.example.com

# The three API services (deploy/README.md §4), host:port. The image's defaults are the services of
# docker-compose.yml; set these only when the services run under other names. nginx uses every address
# a name resolves to: one per reception-list replica, exactly one for the main instance.
# VMS_API_UPSTREAM=backend:8000
# VMS_API_RECEPTION_UPSTREAM=backend-reception:8000
# VMS_API_REPORTS_UPSTREAM=backend-reports:8000
