# Schema owner credential for docker-compose.yml's one-shot `migrate` service (Alembic migrations and
# `python -m app.cli prune-sessions`). Kept out of backend.env so the API container never holds it.
#
#   cp deploy/env/migrate.env.example deploy/env/migrate.env && chmod 600 deploy/env/migrate.env
#
# The owner role created by deploy/postgres/initdb/10-vms-roles.sh, with VMS_OWNER_PASSWORD from
# postgres.env (percent-encoded, see backend.env.example). It must not be the DATABASE_URL role.
MIGRATION_DATABASE_URL=postgresql+psycopg://vms_owner:REPLACE_WITH_VMS_OWNER_PASSWORD@postgres:5432/vms
