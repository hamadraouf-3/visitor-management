# Mawdoo3 Visitors API - production environment for docker-compose.yml (the API services backend,
# backend-reception and backend-reports, and migrate).
#
#   cp deploy/env/backend.env.example deploy/env/backend.env && chmod 600 deploy/env/backend.env
#
# deploy/env/*.env is git-ignored: real values never enter the repository. Every variable is documented
# in the repository's .env.example; this file sets the production values. The API refuses to start
# with an unsafe production configuration (weak or published SECRET_KEY, http origins, COOKIE_SECURE
# false, outbox e-mail, a too-wide TRUSTED_PROXIES, the owner role or a published password as
# DATABASE_URL, ...) and names the problem without echoing values.
#
# The schema owner's URL (MIGRATION_DATABASE_URL) is NOT here: it lives in migrate.env and reaches only
# the one-shot migration and maintenance containers, never the API.

APP_ENV=production

# --- Database ---------------------------------------------------------------------------------------
# The runtime role created by deploy/postgres/initdb/10-vms-roles.sh, with VMS_APP_PASSWORD from
# postgres.env. Percent-encode @ : / ? # [ ] % in the password:
#   python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" '<password>'
DATABASE_URL=postgresql+psycopg://vms_app:REPLACE_WITH_VMS_APP_PASSWORD@postgres:5432/vms
DB_APP_ROLE=vms_app
# Pooled connections per API process (as many again as overflow). docker-compose.yml sets 5 for the three
# read processes (two reception-list replicas, the reports instance): at most 50 API connections in all,
# which its PostgreSQL work_mem budget assumes.
DB_POOL_SIZE=10
# The database is reached over the compose `db` network: a Docker-internal bridge on this host that
# only the postgres, backend and migrate containers join. That is the "network the deployment controls
# end to end" case of SEC-40, so TLS to the database is off here. A database on another host (a managed
# PostgreSQL, a separate server) MUST use TLS: DB_REQUIRE_TLS=true and
# `?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.crt` on both URLs (see docker-compose.yml).
DB_REQUIRE_TLS=false

# --- Security ---------------------------------------------------------------------------------------
# At least 43 random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it ends every browser's device trust and resets the limiter identifiers.
SECRET_KEY=
# The public HTTPS origin (no path). QR codes point to {QR_BASE_URL}/pass#<token>, reset links to
# {APP_BASE_URL}/reset-password#token=...; the host must be one of VMS_SERVER_NAME (frontend.env).
APP_BASE_URL=https://vms.example.com
QR_BASE_URL=https://vms.example.com
# Every origin the browser uses to reach the application (each name in VMS_SERVER_NAME).
ALLOWED_ORIGINS=https://vms.example.com
# The nginx container's fixed address on the compose `app` network (docker-compose.yml): the only peer
# whose X-Forwarded-For (overwritten by nginx with the client's address) and X-Request-ID are believed.
TRUSTED_PROXIES=172.30.47.10/32
COOKIE_SECURE=true
SESSION_MAX_AGE_HOURS=12
SESSION_IDLE_MINUTES=240
# The platform owner's sessions (/platform, B11-6): shorter, the account manages every company.
# Production refuses more than 12 hours and 60 minutes.
PLATFORM_SESSION_MAX_AGE_HOURS=8
PLATFORM_SESSION_IDLE_MINUTES=30
# Concurrent Argon2id hashes (64 MiB each). The default is the host's CPU count, which a container does
# not limit: keep it within the backend's memory limit in docker-compose.yml (4 x 64 MiB of 1 GiB). The
# read services receive no sign-ins; docker-compose.yml gives them 1.
PASSWORD_HASH_CONCURRENCY=4
# Must equal client_max_body_size of the API locations in deploy/nginx (64k). The upload of a company's
# logo or icon has a fixed limit of its own in both, 512 KiB, whatever this value is.
MAX_REQUEST_BODY_BYTES=65536

# --- E-mail -----------------------------------------------------------------------------------------
# resend (recommended: a domain verified in Resend) or smtp (any mail server over TLS). Production
# refuses outbox, memory and SMTP_SECURITY=none. After a change, recreate the API containers and run
#   docker compose run --rm --no-deps backend python -m app.cli send-test-email --to you@example.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Only with EMAIL_PROVIDER=smtp. starttls uses port 587 and ssl 465 unless SMTP_PORT says otherwise; the
# server's certificate must match SMTP_HOST. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_SECURITY=ssl (or SMTP_PORT=587 with SMTP_SECURITY=starttls where outbound 587 is open),
# SMTP_USERNAME=<the Gmail address>, SMTP_PASSWORD=<an App Password: 2-Step Verification on, then
# myaccount.google.com/apppasswords>, EMAIL_FROM=<the same address>; Gmail limits sending to a few
# hundred messages a day, so it suits a pilot rather than a busy site.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=Mawdoo3 Visitors <no-reply@vms.example.com>
EMAIL_REPLY_TO=

# --- Names ------------------------------------------------------------------------------------------
# The organisation behind the logo of the test message of send-test-email, and the product (that
# message's footer and sender, the OpenAPI title). Every e-mail to a company's staff and visitors shows
# that company only (its logo or name, its colour, its name as the sender's; B12-22): the platform owner
# sets a company's logo and colour in the application (B12-7), never here. The defaults are Mawdoo3's.
BRAND_NAME_AR=موضوع
BRAND_NAME_EN=Mawdoo3
PRODUCT_NAME_AR=زوار موضوع
PRODUCT_NAME_EN=Mawdoo3 Visitors

# --- Rate limits ------------------------------------------------------------------------------------
# Production refuses RATE_LIMIT_ENABLED=false and guessing/recovery limits above ten times the defaults.
# The defaults (repository .env.example) suit most sites; raise throughput budgets for very busy desks.
RATE_LIMIT_ENABLED=true

# --- Logging ----------------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Company defaults -------------------------------------------------------------------------------
# Timezone of companies created with `app.cli create-admin` (IANA name).
SEED_COMPANY_TIMEZONE=Asia/Amman
# Never set SEED_DEMO_PASSWORD in production (seeding is refused there anyway).
