# PostgreSQL service of docker-compose.yml.
#
#   cp deploy/env/postgres.env.example deploy/env/postgres.env && chmod 600 deploy/env/postgres.env
#
# Read by the postgres image when it initialises an EMPTY data volume (first start); changing them later
# changes nothing (use ALTER ROLE ... PASSWORD, then update the URLs in backend.env / migrate.env).
# Generate each password separately, e.g. `openssl rand -base64 32` (at least 24 characters).

# Superuser `postgres`. Reachable only over the container's local socket (deploy/postgres/pg_hba.conf
# refuses it over the network); used for restores and emergencies.
POSTGRES_PASSWORD=

# Roles created by deploy/postgres/initdb/10-vms-roles.sh. The same passwords appear, percent-encoded,
# in MIGRATION_DATABASE_URL (migrate.env) and DATABASE_URL (backend.env).
# With Docker secrets instead: VMS_OWNER_PASSWORD_FILE=/run/secrets/... (and POSTGRES_PASSWORD_FILE).
VMS_OWNER_PASSWORD=
VMS_APP_PASSWORD=
