# Normalise text files in the repository; check them out with the platform's line endings,
# except files that run inside Linux containers or POSIX shells, which must stay LF.
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerignore text eol=lf
docker-compose.yml text eol=lf
# Binary assets
*.png binary
*.ico binary
*.wasm binary
*.dump binary
