      "input": "https://visitors.example.com/pass/extra#Xo3_vK9-aQ2rT7mN4bL8cY1zW6eH5jP0sD-gF_uIk2A",
      "expected": null
    },
    {
      "name": "path prefix before /pass",
      "input": "https://visitors.example.com/vms/pass#Xo3_vK9-aQ2rT7mN4bL8cY1zW6eH5jP0sD-gF_uIk2A",
      "expected": null
