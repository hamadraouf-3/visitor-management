# Mawdoo3 Visitors — environment configuration.
# Copy to `.env` for local development. Never commit real secrets. Values below are LOCAL DEFAULTS
# matching scripts/db.ps1; production must override every secret and is validated at startup.

# Required (no default): development | test | production. A deployment that omits it refuses to start
# instead of silently running with the development posture (dev secret, outbox e-mail, open API docs).
APP_ENV=development

# --- Database ---------------------------------------------------------------------------------------
# Runtime role: DML only (INSERT/SELECT on audit_logs). Used by the API, CLI and email dispatcher.
# Production refuses to start when it is the owner role below, a role with more privileges than the
# migrations grant it, a role with default settings of its own (ALTER ROLE ... SET), or uses the
# published local password, wherever it comes from (the URL, a `?password=` parameter, PGPASSWORD, a
# password file or a connection service). It must be a plain LOGIN role: no other attribute (SUPERUSER,
# CREATEDB, CREATEROLE, REPLICATION, BYPASSRLS), a member of no role (pg_monitor and the other predefined
# roles included), the role the connection logs in as (no `role` set by a startup option or role
# default), and hold no table privileges beyond the migrations' grants (SELECT, INSERT, UPDATE on the
# business tables; SELECT and INSERT without `seq` on audit_logs; nothing on alembic_version: no
# MAINTAIN, TRIGGER, REFERENCES, DELETE or TRUNCATE anywhere). Percent-encode @ : / ? # [ ] % in user
# names and passwords (urllib.parse.quote(password, safe='')); an ambiguous URL is refused at startup.
# Every connection pins the session settings the application relies on (READ COMMITTED, read-write,
# search_path=public, UTC, ...), whatever the role or database defaults are.
# Rotating the runtime credential: also run `ALTER ROLE vms_app RESET ALL` (and
# `ALTER ROLE vms_app IN DATABASE vms RESET ALL`) as that role or a superuser, so no default it was given
# outlives the rotation (first `SET default_transaction_read_only = off` if a read-only default was
# planted). Run Alembic downgrades with the API stopped.
DATABASE_URL=postgresql+psycopg://vms_app:vms_app_local_dev@localhost:5433/vms
# Schema owner: used only by Alembic migrations (and by the test harness to create throwaway DBs).
MIGRATION_DATABASE_URL=postgresql+psycopg://vms_owner:vms_owner_local_dev@localhost:5433/vms
# Role the initial migration grants runtime privileges to.
DB_APP_ROLE=vms_app
DB_POOL_SIZE=10
# How long the API waits for the database before it answers 503 SERVICE_BUSY instead of hanging: a new
# connection (libpq connect_timeout, per address the host name resolves to; psycopg's own default is
# 130 s), a free pooled connection, one statement (statement_timeout) and one lock (lock_timeout). Every
# connection also gets TCP keepalives (a peer that vanished is noticed in about a minute) and, on Linux,
# a 30 s TCP user timeout. libpq parameters given in DATABASE_URL's query string (e.g.
# ?connect_timeout=10) take precedence. GET /health uses its own connection with 2 s timeouts and answers
# within 3 s whatever the database does. Migrations (MIGRATION_DATABASE_URL) get no statement timeout.
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
# Production refuses database URLs that do not verify the server's certificate, unless they connect over
# a Unix socket or loopback: add `?sslmode=verify-full` (with `&sslrootcert=/path/ca.pem`, or
# `sslrootcert=system`) to both URLs, or set PGSSLMODE=verify-full. libpq's default (prefer) silently
# falls back to plain text. PGHOSTADDR counts as where the connection goes. With a connection service
# (`?service=name` in the URL, or PGSERVICE), whose pg_service.conf entry can name any host and an
# sslmode that outranks PGSSLMODE, the sslmode must be in the URL itself. Set false only for a database
# on a network the deployment controls end to end (e.g. the docker-compose network of one host).
DB_REQUIRE_TLS=true

# --- Security ---------------------------------------------------------------------------------------
# At least 43 random characters in production: `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Keys the device cookies (a browser trusted for an account) and the rate-limiter identifiers (no raw
# e-mail addresses in memory). Production refuses keys built from words, dates, keyboard walks or
# repetitions: a human-made key can be guessed offline from one device cookie. Left empty on purpose:
# empty means a built-in development key, which production refuses (as it refuses placeholder-like values).
SECRET_KEY=
# Public ORIGINS (scheme://host[:port], no path, query or credentials) of the web app (reset links
# {APP_BASE_URL}/reset-password) and of the visitor pass page (QR codes {QR_BASE_URL}/pass#<token>).
# The SPA serves both pages at the root; a path such as https://host/vms is rejected at startup.
# QR_BASE_URL defaults to APP_BASE_URL. Production requires https.
APP_BASE_URL=http://localhost:5173
QR_BASE_URL=http://localhost:5173
# Comma-separated exact origins allowed to send unsafe requests ('*' is rejected).
# Add LAN tablet origins here, e.g. https://192.168.1.20:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For (and X-Request-ID) is trusted (empty =
# none). List the proxies' own addresses: production refuses anything wider than /8 (IPv4) or /32
# (IPv6), e.g. 0.0.0.0/0, which would let any client choose its address. A request ID sent by any other
# peer is ignored (a new one is generated). The Vite dev proxy connects from loopback and sends
# X-Forwarded-For (xfwd).
# Caveat: a request that reaches the API DIRECTLY from a trusted address without X-Forwarded-For
# (curl, the /docs "Try it out" page, a test harness calling port 8000) has no known client IP (contract
# §7.3): it is logged/audited with ip NULL, and all such clients share ONE per-IP rate-limit budget
# (login failures 30/5 min, forgot-password 10/15 min, reset-password 20/15 min). Leave this empty when
# you call the backend directly instead of through the Vite proxy; E2E runs go through the Vite proxy
# (or set RATE_LIMIT_ENABLED=false for direct calls).
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# true => __Host-vms_session / __Host-vms_csrf (Secure). false only for plain-http local dev; refused in production.
COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=12
SESSION_IDLE_MINUTES=240
# The platform owner's sessions (/platform, B11-6): shorter, the account manages every company.
# Production refuses more than 12 hours and 60 minutes.
PLATFORM_SESSION_MAX_AGE_HOURS=8
PLATFORM_SESSION_IDLE_MINUTES=30
# Concurrent Argon2 hash operations (default: CPU count); saturation answers 503 SERVICE_BUSY.
# PASSWORD_HASH_CONCURRENCY=4
# Largest accepted API request body in bytes (larger bodies answer 413 PAYLOAD_TOO_LARGE).
MAX_REQUEST_BODY_BYTES=65536

# --- Server (`python -m app.serve`, the one supported run command) -----------------------------------
# Address and port; --host/--port override them. X-Forwarded-For is honoured only from TRUSTED_PROXIES.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# --- E-mail -----------------------------------------------------------------------------------------
# resend | smtp | outbox (files in EMAIL_OUTBOX_DIR; dev/E2E only) | memory (tests only)
# Check any provider with: python -m app.cli send-test-email --to you@example.com (from backend/).
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
# EMAIL_PROVIDER=smtp: any SMTP server. SMTP_SECURITY is starttls (SMTP_PORT 587 by default), ssl
# (TLS from the first byte, 465) or none (25; development and tests only, for a local capture server
# such as Mailpit; no credentials). The certificate is checked against SMTP_HOST. SMTP_USERNAME and
# SMTP_PASSWORD go together (both empty: no sign-in). SMTP_TIMEOUT_SECONDS bounds the connection and
# each wait for the server, within the message's 20 s deadline.
#
# Gmail (a quick start; for production use Resend or your organisation's mail server with your own
# domain: Gmail limits sending to a few hundred messages a day):
#   1. Turn on 2-Step Verification for the Google account (myaccount.google.com > Security).
#   2. Create an App Password (myaccount.google.com/apppasswords). Google shows 16 letters; spaces
#      are optional here.
#   3. EMAIL_PROVIDER=smtp, SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURITY=ssl (TLS from the
#      first byte; it works where a network blocks outbound 587, as the demo's does; where 587 is open,
#      SMTP_PORT=587 with SMTP_SECURITY=starttls works the same way),
#      SMTP_USERNAME=<the Gmail address>, SMTP_PASSWORD=<the App Password, never the account password>,
#      EMAIL_FROM=Mawdoo3 Visitors <the same Gmail address> (Gmail sends from the signed-in account).
#   4. Restart the API, then run send-test-email. Set QR_BASE_URL to an address the visitors' phones can
#      open (this computer's LAN address, or the public https:// origin), or the pass links open nothing.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
# The address every e-mail is sent from. A company's e-mails keep this address and carry the company's
# own name as the sender's name (B12-13); the name written here is the sender's name of the
# platform-level e-mails only (the notice of a platform action, send-test-email): use the product's.
EMAIL_FROM=Mawdoo3 Visitors <no-reply@demo.local>
EMAIL_REPLY_TO=
# Absolute, or relative to backend/ and inside var/ (the only git-ignored place there; outbox files hold
# raw pass and reset links). Quote Windows paths in Git Bash, which otherwise drops their backslashes.
EMAIL_OUTBOX_DIR=var/outbox
# Non-production only: recipients at this domain fail permanently (exercise failure handling).
EMAIL_FAIL_DOMAIN=
# E-mails delivered at the same time. Deliveries run after the response, in worker threads of their own
# (never those requests use), so a slow or unreachable provider delays only e-mail: each message has up
# to 3 attempts within a 20 s deadline (5 s to connect, 10 s per read). A message still PENDING
# 5 minutes after its last activity (its delivery was lost with a restart or crash, or waited too long
# for a slot) is marked FAILED at startup or by the minutely sweep and shows under Needs attention.
EMAIL_DELIVERY_CONCURRENCY=4

# --- Names ------------------------------------------------------------------------------------------
# docs/decisions/phase-10-backend.md, B10-5 and B10-16. One line of visible text each, at most 60
# characters. A company (tenant) is never named here: its names are company settings.
# No e-mail to a company's staff or visitors shows these names (B12-12, B12-22: its logo or name, its
# colour, "Sent by <company>", the notice of what the platform owner did included). They name the test
# message of send-test-email and the platform owner's pages.
# The organisation whose logo the test message carries: the logo's text alternative.
BRAND_NAME_AR=موضوع
BRAND_NAME_EN=Mawdoo3
# The product: the test message's footer ("Sent by Mawdoo3 Visitors.") and the first line of its
# plain-text part, EMAIL_FROM's default display name and the OpenAPI title (English).
PRODUCT_NAME_AR=زوار موضوع
PRODUCT_NAME_EN=Mawdoo3 Visitors

# --- Rate limits (contract §7.3) --------------------------------------------------------------------
# Per-IP limits apply to an IPv4 address or to a whole IPv6 /64 (one client controls the entire prefix).
# Production refuses RATE_LIMIT_ENABLED=false, any of the login, change-password, forgot-password,
# reset-password, taken-address and public-identity limits below set above ten times its default (beyond
# that it limits nothing), and either bucket cap below set under a tenth of its default.
RATE_LIMIT_ENABLED=true
# Failed logins per (IP, e-mail) / per IP / per account (the account limit locks it out for 15 min).
# The account lockout applies to untrusted browsers only: a browser that signed in to the account (or
# completed its password reset) holds a device cookie and has its own budget of the same size instead.
# A password change or reset, or a deactivation, ends the trust of every other browser of the account.
RATE_LIMIT_LOGIN_PER_IP_EMAIL=5
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_LOGIN_PER_ACCOUNT=10
# Successful logins per account / 15 min (each writes a session and an audit row); beyond it 429.
# E2E suites that sign in to one account more often than this can raise it.
RATE_LIMIT_LOGIN_SUCCESSES_PER_ACCOUNT=30
# Wrong current passwords on POST /auth/change-password per user / 15 min; the attempt that reaches the
# limit also ends that session.
RATE_LIMIT_PASSWORD_CHANGE_PER_USER=5
# Successful password changes per account / hour (each costs two Argon2 operations and writes a session
# and an audit row); beyond it 429 before any hashing until the hour frees a slot (a password reset
# still works). E2E suites that change one account's password more often can raise it.
RATE_LIMIT_PASSWORD_CHANGES_PER_HOUR=5
# POST /users refused because the address is already taken (in any company: e-mail addresses are
# unique system-wide) per administrator / hour, and per company / hour (an administrator can create more
# administrators, so the company is the bound); beyond either, every POST /users of that administrator
# or company answers 429 until the hour frees a slot. A typo or two never reaches them.
RATE_LIMIT_USER_EMAIL_REFUSALS_PER_HOUR=10
RATE_LIMIT_USER_EMAIL_REFUSALS_PER_COMPANY_PER_HOUR=20
# Reset e-mails per existing account / 15 min (whoever asks), and forgot-password requests per IP.
RATE_LIMIT_FORGOT_PER_EMAIL=3
RATE_LIMIT_FORGOT_PER_IP=10
# POST /auth/reset-password attempts per IP / 15 min (checked before the token lookup).
RATE_LIMIT_RESET_PER_IP=20
# Secondary limits per IPv6 /48 for login failures (/5 min), forgot-password and reset-password
# (/15 min): one site can rotate through 65,536 /64 subjects. IPv4 clients are not affected.
RATE_LIMIT_LOGIN_PER_PREFIX=300
RATE_LIMIT_FORGOT_PER_PREFIX=100
RATE_LIMIT_RESET_PER_PREFIX=200
# Caps on limiter entries keyed by anonymous input: client addresses / IPv6 prefixes, and e-mail
# addresses typed into the login form (separate caps, so free e-mail strings cannot use up the room the
# per-network limits need). Entries expire with their own window. A full cap never refuses a request:
# new keys of that kind are simply not tracked until entries expire (the request is still judged by its
# other limits, and per-account limits of existing accounts are never capped). At most about 1.3 KB
# per network entry and 0.7 KB per e-mail entry: about 200 MB with both caps reached. Production
# refuses caps below 10000: a small cap lets a few hundred addresses switch the per-network limits off.
RATE_LIMIT_MAX_NETWORK_BUCKETS=100000
RATE_LIMIT_MAX_EMAIL_BUCKETS=100000
RATE_LIMIT_SCAN_PER_MINUTE=120
# Refused check-ins, check-outs and walk-ins without a scanned pass (MANUAL, OVERRIDE, CORRECTED,
# walk-in) per user / min; each refusal is an audit row. Beyond it these requests answer 429 until
# the minute frees a slot. Successful ones never count; QR attempts count against the scan limit.
RATE_LIMIT_ATTENDANCE_REFUSALS_PER_MINUTE=30
RATE_LIMIT_RESENDS_PER_VISIT_HOUR=3
RATE_LIMIT_API_PER_MINUTE=600
# Invitation e-mails (new visits with an invitation, resends, re-sends after a visitor's address
# changed) per user / 24 h; beyond it the request is refused (429 INVITATION_LIMIT).
INVITATION_DAILY_LIMIT=50
# "Your visit has been rescheduled" e-mails per user / 24 h and per visit / hour. Beyond them the new
# time is still saved; only the e-mail is left out (recorded in the audit log).
RESCHEDULE_NOTICE_DAILY_LIMIT=50
RATE_LIMIT_RESCHEDULE_NOTICES_PER_VISIT_HOUR=3
# "Your visitor has arrived" e-mails to hosts per user who checks visitors in (or registers walk-ins)
# / 24 h. Beyond it the check-in still succeeds; only the e-mail is left out (recorded in the audit
# log). Set it above the busiest reception account's daily check-ins (a shared desk account counts
# every check-in made with it).
HOST_ARRIVAL_DAILY_LIMIT=500
# Test e-mails of a company's edited e-mail texts, to the administrator's own address, per
# administrator / hour (B11-29); beyond it 429 RATE_LIMITED.
RATE_LIMIT_TEMPLATE_TEST_SENDS_PER_HOUR=5
# The public identity endpoints (/api/v1/public: a company's name, logo, colour and web app manifest,
# which the sign-in and pass pages read without a session, B12-9) per client address / min and per IPv6
# /48 / min; beyond it 429 RATE_LIMITED. Every request counts, whatever it asks for. Generous on
# purpose: a whole office behind one address opens the sign-in page in the morning. Production refuses
# more than ten times these defaults (the endpoints tell anyone whether a company exists).
RATE_LIMIT_PUBLIC_BRAND_PER_IP=600
RATE_LIMIT_PUBLIC_BRAND_PER_PREFIX=6000
# Changes of companies' brands (a logo or icon stored or removed, a colour) per platform account /
# hour (B12-7); beyond it 429 RATE_LIMITED.
RATE_LIMIT_BRAND_CHANGES_PER_HOUR=120

# --- Logging ----------------------------------------------------------------------------------------
# DEBUG applies to the application's own loggers; uvicorn's and the websockets library's stay at INFO
# (their debug output writes raw request headers, cookies included, into the log message).
LOG_LEVEL=INFO
LOG_JSON=true

# --- Seeding (non-production CLI) -------------------------------------------------------------------
SEED_COMPANY_TIMEZONE=Asia/Amman
# Password for all seeded demo/E2E users. Local default when unset: Demo-Visitor-2026
SEED_DEMO_PASSWORD=Demo-Visitor-2026
